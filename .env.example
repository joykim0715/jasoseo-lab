# 자소서 자동화 웹앱 환경변수
# 복사: cp .env.example .env.local

# LLM — 무료 권장: Groq 주 / Gemini 보조
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# (선택) 유료 OpenAI — 결제/크레딧 필요. 없으면 무시됨
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Notion Internal Integration (선택 — 없으면 포트폴리오 스냅샷만 사용)
NOTION_TOKEN=
NOTION_EXPERIENCE_DB_ID=
NOTION_ESSAY_DB_ID=

# 사이트 URL
NEXT_PUBLIC_SITE_URL=https://jasoseo-lab.vercel.app
NEXT_PUBLIC_PORTFOLIO_URL=https://kiminhong-portfolio.vercel.app
